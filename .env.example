FALKOR_HOST=
FALKOR_PASS=
FALKOR_PORT=6379
FALKOR_USER=
GITHUB_TOKEN=
# Approved actions on repositories listed here (comma-separated owner/name) go to the real
# pull request: reviewer requests and labels. Defaults to the sandbox repository only.
KEYSTONE_WRITE_REPOS=
# Every other repository runs in shadow mode: approved actions are written to a tracking
# issue here, with logins as code so nobody upstream is notified.
KEYSTONE_SANDBOX_REPO=yashsejuro/keystone-sandbox
# Optional persistent MCP connection. Leave blank for a temporary demo tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_TUNNEL_NAME=
MCP_PUBLIC_URL=