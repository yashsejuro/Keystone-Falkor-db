# FalkorDB Database Configuration
FALKOR_HOST=
FALKOR_PORT=6379
FALKOR_USER=
FALKOR_PASS=

# GitHub API Access (Required for real repository ingestion and live action dispatch)
GITHUB_TOKEN=

# Action Dispatch Configuration
# Repositories allowed for LIVE execution on GitHub (comma-separated owner/name)
KEYSTONE_WRITE_REPOS=
# Tracking repository for SHADOW mode actions (where actions are safeguarded)
KEYSTONE_SANDBOX_REPO=yashsejuro/keystone-sandbox

# Optional FastMCP Configuration
PORT=3000
MCP_PUBLIC_URL=